// Medilink baseline schema — Stage 4.1.
// PostgreSQL is the single primary datastore. Binary files (credential scans,
// facility licences, photographs, dispute evidence) live in Tigris object
// storage; only their keys and metadata are recorded here.
//
// Conventions, enforced by review:
//   * UUID primary keys, generated by the database
//   * created_at / updated_at on every table
//   * deleted_at for soft delete where records must survive for audit
//   * every state change writes an audit.audit_log row in the same transaction

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "audit", "config", "storage", "practitioners", "credentials", "facilities"]
}

// ---------------------------------------------------------------- identity

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique
  phone         String    @unique
  passwordHash  String?   @map("password_hash")
  fullName      String    @map("full_name")
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  roles         UserRole[]
  sessions      Session[]
  devices       Device[]
  otpCodes      OtpCode[]
  loginAttempts LoginAttempt[]
  practitionerProfile PractitionerProfile?
  credentialSubmissions CredentialSubmission[]
  representedFacilities Facility[]

  @@map("users")
  @@schema("identity")
}

enum UserStatus {
  PENDING_VERIFICATION
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@schema("identity")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
  @@schema("identity")
}

// Permissions are the unit of authorisation. A role is a bundle of
// permissions and is never sufficient on its own — see src/lib/authz.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  roles       RolePermission[]

  @@map("permissions")
  @@schema("identity")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

// Scope columns carry the tenant boundary: a grant is always "this permission,
// within this facility / branch / department", never a bare global role.
model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  scopeType    ScopeType @map("scope_type")
  scopeId      String?  @map("scope_id") @db.Uuid
  grantedBy    String?  @map("granted_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId, revokedAt])
  @@map("user_roles")
  @@schema("identity")
}

enum ScopeType {
  PLATFORM
  FACILITY_GROUP
  FACILITY
  BRANCH
  DEPARTMENT
  SELF

  @@schema("identity")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  stepUpAt       DateTime? @map("step_up_at")
  expiresAt      DateTime @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
  @@schema("identity")
}

model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  label      String?
  platform   String?
  pushToken  String?  @map("push_token")
  lastSeenAt DateTime? @map("last_seen_at")
  trustedAt  DateTime? @map("trusted_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
  @@schema("identity")
}

model OtpCode {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  purpose    OtpPurpose
  codeHash   String   @map("code_hash")
  expiresAt  DateTime @map("expires_at")
  attempts   Int      @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@map("otp_codes")
  @@schema("identity")
}

enum OtpPurpose {
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  LOGIN
  PASSWORD_RESET
  STEP_UP

  @@schema("identity")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  identifier String
  succeeded  Boolean
  ipAddress  String?  @map("ip_address")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, createdAt])
  @@map("login_attempts")
  @@schema("identity")
}

// ---------------------------------------------------------------- audit

// Append-only. No update or delete path exists in application code, and the
// test harness fails the suite if a state change leaves no row here.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  actorType     String   @default("user") @map("actor_type")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  scopeType     String?  @map("scope_type")
  scopeId       String?  @map("scope_id") @db.Uuid
  reason        String?
  before        Json?
  after         Json?
  correlationId String?  @map("correlation_id")
  requestId     String?  @map("request_id")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([correlationId])
  @@map("audit_log")
  @@schema("audit")
}

// Transactional outbox. Events are written in the same transaction as the
// state change, so an event cannot be lost when a consumer fails.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  correlationId String?   @map("correlation_id")
  idempotencyKey String?  @unique @map("idempotency_key")
  status        OutboxStatus @default(PENDING)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  availableAt   DateTime  @default(now()) @map("available_at")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("outbox_events")
  @@schema("audit")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER

  @@schema("audit")
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  kind      String
  severity  String   @default("info")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@map("security_events")
  @@schema("audit")
}

// ---------------------------------------------------------------- config

// Controlled vocabularies. Every list has a named owner, because an
// unowned configuration list rots. Loaded by migration and seed only.
model ProfessionalCategory {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String
  regulator String
  isActive  Boolean  @default(true) @map("is_active")
  owner     String
  createdAt DateTime @default(now()) @map("created_at")

  specialties Specialty[]
  practitionerProfiles PractitionerProfile[]

  @@map("professional_categories")
  @@schema("config")
}

model Specialty {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  key        String   @unique
  name       String
  isActive   Boolean  @default(true) @map("is_active")
  owner      String
  createdAt  DateTime @default(now()) @map("created_at")

  category ProfessionalCategory @relation(fields: [categoryId], references: [id])
  practitionerProfiles PractitionerProfile[]

  @@map("specialties")
  @@schema("config")
}

model CredentialType {
  id            String  @id @default(uuid()) @db.Uuid
  key           String  @unique
  name          String
  issuer        String
  isMandatory   Boolean @default(false) @map("is_mandatory")
  expires       Boolean @default(true)
  reviewDays    Int     @default(365) @map("review_days")
  verificationMethod String @map("verification_method")
  owner         String
  createdAt     DateTime @default(now()) @map("created_at")

  submissions CredentialSubmission[]

  @@map("credential_types")
  @@schema("config")
}

model State {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  zone      String
  owner     String
  createdAt DateTime @default(now()) @map("created_at")

  lgas Lga[]
  practitionerProfiles PractitionerProfile[]
  facilities Facility[]

  @@map("states")
  @@schema("config")
}

model Lga {
  id        String   @id @default(uuid()) @db.Uuid
  stateId   String   @map("state_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)
  facilities Facility[]

  @@unique([stateId, name])
  @@map("lgas")
  @@schema("config")
}

model FacilityType {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String
  regulator String
  owner     String
  createdAt DateTime @default(now()) @map("created_at")

  facilities Facility[]

  @@map("facility_types")
  @@schema("config")
}

model PublicHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  name      String
  year      Int
  owner     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date, name])
  @@map("public_holidays")
  @@schema("config")
}

// Rate floors exist from day one so a shift can never be published below
// a defensible minimum. Money is stored in kobo as an integer.
model RateFloor {
  id            String   @id @default(uuid()) @db.Uuid
  categoryKey   String   @map("category_key")
  specialtyKey  String   @default("*") @map("specialty_key")
  shiftType     String   @map("shift_type")
  minHourlyKobo Int      @map("min_hourly_kobo")
  currency      String   @default("NGN")
  effectiveFrom DateTime @map("effective_from")
  owner         String
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([categoryKey, specialtyKey, shiftType, effectiveFrom])
  @@map("rate_floors")
  @@schema("config")
}

// ---------------------------------------------------------------- storage

// One row per object held in Tigris. The bytes are never in PostgreSQL:
// this table records the key, integrity data and who may retrieve it.
model StoredObject {
  id            String   @id @default(uuid()) @db.Uuid
  bucket        String
  objectKey     String   @unique @map("object_key")
  contentType   String   @map("content_type")
  sizeBytes     Int      @map("size_bytes")
  checksumSha256 String? @map("checksum_sha256")
  purpose       String
  ownerUserId   String?  @map("owner_user_id") @db.Uuid
  scopeType     String?  @map("scope_type")
  scopeId       String?  @map("scope_id") @db.Uuid
  uploadedAt    DateTime? @map("uploaded_at")
  createdAt     DateTime @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([ownerUserId, purpose])
  @@map("stored_objects")
  @@schema("storage")
}

// ------------------------------------------------------------ practitioners

// One profile per user. Identity and licence verification (NIN, practising
// licence, documents) are the credentials module's job, not this one's —
// this table holds only what a practitioner chooses to present.
model PractitionerProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  professionalCategoryId String    @map("professional_category_id") @db.Uuid
  specialtyId            String?   @map("specialty_id") @db.Uuid
  yearsOfExperience      Int       @map("years_of_experience")
  bio                    String?
  photoObjectKey         String?   @map("photo_object_key")
  homeStateId            String?   @map("home_state_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalCategory ProfessionalCategory @relation(fields: [professionalCategoryId], references: [id])
  specialty            Specialty?           @relation(fields: [specialtyId], references: [id])
  homeState            State?               @relation(fields: [homeStateId], references: [id])

  @@map("practitioner_profiles")
  @@schema("practitioners")
}

// ------------------------------------------------------------- credentials

// Many rows per user: a practitioner holds several credential types over
// time and may resubmit after a rejection. "Active" (not yet superseded)
// means PENDING or VERIFIED; a REJECTED row does not block a fresh
// submission of the same type.
model CredentialSubmission {
  id                String                     @id @default(uuid()) @db.Uuid
  userId            String                     @map("user_id") @db.Uuid
  credentialTypeId  String                     @map("credential_type_id") @db.Uuid
  status            CredentialSubmissionStatus @default(PENDING)
  referenceNumber   String?                    @map("reference_number")
  documentObjectKey String?                    @map("document_object_key")
  // Who reviewed it, when and why. A bare column, not a Prisma relation —
  // matching the existing precedent of audit.security_events.user_id, which
  // also has no @relation and no back-relation on User. The audit row
  // reviewCredential writes in the same transaction is the system of record
  // for "who did this"; this is a denormalised convenience for reading a
  // submission back without a join to audit_log.
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at")
  reviewNotes String?   @map("review_notes")
  // Computed once at verification time from credentialType.reviewDays when
  // credentialType.expires is true. Nothing reads this yet — no expiry
  // sweep exists — stored now so a future one is additive, not a backfill.
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialType CredentialType @relation(fields: [credentialTypeId], references: [id])

  @@index([userId, credentialTypeId])
  @@index([status])
  @@map("credential_submissions")
  @@schema("credentials")
}

enum CredentialSubmissionStatus {
  PENDING
  VERIFIED
  REJECTED

  @@schema("credentials")
}

// ---------------------------------------------------------------- facilities

// A facility is an organisation, not a person, so it is created by Medilink
// operations rather than self-declared: verification exists precisely to stop
// anyone claiming to be a hospital. The named representative is granted
// facility_owner over this facility at creation, in the same transaction.
model Facility {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  facilityTypeId String  @map("facility_type_id") @db.Uuid
  // Unique at the database level, not checked in application code: step 5.4
  // asks for a duplicate to be refused "on the constraint, not in code".
  cacNumber      String  @unique @map("cac_number")

  stateId     String  @map("state_id") @db.Uuid
  lgaId       String? @map("lga_id") @db.Uuid
  addressLine String  @map("address_line")

  contactPhone String  @map("contact_phone")
  contactEmail String? @map("contact_email")

  representativeUserId String @map("representative_user_id") @db.Uuid

  status FacilityStatus @default(PENDING)

  licenceNumber    String?   @map("licence_number")
  licenceObjectKey String?   @map("licence_object_key")
  // Read by canPublish() at publish time, which needs no scheduler. The
  // automatic suspension of step 5.9 does, and does not exist yet.
  licenceExpiresAt DateTime? @map("licence_expires_at")

  // Who verified it, when and why. A bare column, not a Prisma relation,
  // matching CredentialSubmission.reviewedBy: the audit row written in the
  // same transaction is the system of record for "who did this".
  verifiedBy  String?   @map("verified_by") @db.Uuid
  verifiedAt  DateTime? @map("verified_at")
  reviewNotes String?   @map("review_notes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  facilityType FacilityType @relation(fields: [facilityTypeId], references: [id])
  state        State        @relation(fields: [stateId], references: [id])
  lga          Lga?         @relation(fields: [lgaId], references: [id])
  // Restrict, not Cascade: removing the person must never silently remove the
  // organisation they happened to represent.
  representative User @relation(fields: [representativeUserId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([stateId, status])
  @@index([representativeUserId])
  @@map("facilities")
  @@schema("facilities")
}

enum FacilityStatus {
  PENDING
  VERIFIED
  REJECTED
  // Reachable by no code path in this cut. It exists because canPublish must
  // decide on it, and because step 5.9 (expiry) and module 15 (clinical
  // incidents) both suspend a facility rather than delete it.
  SUSPENDED

  @@schema("facilities")
}

// Scheduled jobs. The sweeps Stage 5 needs — credential expiry, sanctions
// screening, eligibility recomputation — and the ones Stage 7 will need. Runs
// in the same worker process as the outbox, claimed the same way, because the
// stack decision is "Postgres outbox plus worker; Redis/BullMQ only if
// needed" and this needs neither.
model ScheduledJob {
  id              String    @id @default(uuid()) @db.Uuid
  key             String    @unique
  description     String
  intervalSeconds Int       @map("interval_seconds")
  // An operator's off switch: a sweep misbehaving in production is disabled
  // in one row, without a deploy.
  enabled         Boolean   @default(true)
  nextRunAt       DateTime  @default(now()) @map("next_run_at")
  lastRunAt       DateTime? @map("last_run_at")
  lastStatus      ScheduledJobStatus? @map("last_status")
  lastError       String?   @map("last_error")
  lastDurationMs  Int?      @map("last_duration_ms")
  failureCount    Int       @default(0) @map("failure_count")
  runCount        Int       @default(0) @map("run_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([enabled, nextRunAt])
  @@map("scheduled_jobs")
  @@schema("audit")
}

enum ScheduledJobStatus {
  SUCCEEDED
  FAILED

  @@schema("audit")
}
