// Medilink baseline schema — Stage 4.1.
// PostgreSQL is the single primary datastore. Binary files (credential scans,
// facility licences, photographs, dispute evidence) live in Tigris object
// storage; only their keys and metadata are recorded here.
//
// Conventions, enforced by review:
//   * UUID primary keys, generated by the database
//   * created_at / updated_at on every table
//   * deleted_at for soft delete where records must survive for audit
//   * every state change writes an audit.audit_log row in the same transaction

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "audit", "config", "storage", "practitioners", "credentials", "facilities", "availability", "service_requests", "matching", "notifications", "attendance", "timesheets", "cancellations_sanctions", "disputes", "clinical_incidents", "suggestions", "rates", "billing", "consent"]
}

// ---------------------------------------------------------------- identity

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique
  phone         String    @unique
  passwordHash  String?   @map("password_hash")
  fullName      String    @map("full_name")
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  roles         UserRole[]
  sessions      Session[]
  devices       Device[]
  otpCodes      OtpCode[]
  loginAttempts LoginAttempt[]
  practitionerProfile PractitionerProfile?
  credentialSubmissions CredentialSubmission[]
  representedFacilities Facility[]
  payouts               Payout[]
  payoutAccounts        PayoutAccount[]
  agreementAcceptances  AgreementAcceptance[]
  consentRecords        ConsentRecord[]
  dataSubjectRequests   DataSubjectRequest[]
  identityVerification IdentityVerification?
  suspensions   AccountSuspension[]
  screeningResult ScreeningResult?
  availabilitySlots AvailabilitySlot[]
  assignments       Assignment[]
  checkInEvents     CheckInEvent[]
  blockedPeriods    BlockedPeriod[]
  professionalRegistrations ProfessionalRegistration[]

  @@map("users")
  @@schema("identity")
}

enum UserStatus {
  PENDING_VERIFICATION
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@schema("identity")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
  @@schema("identity")
}

// Permissions are the unit of authorisation. A role is a bundle of
// permissions and is never sufficient on its own — see src/lib/authz.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  roles       RolePermission[]

  @@map("permissions")
  @@schema("identity")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

// Scope columns carry the tenant boundary: a grant is always "this permission,
// within this facility / branch / department", never a bare global role.
model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  scopeType    ScopeType @map("scope_type")
  scopeId      String?  @map("scope_id") @db.Uuid
  grantedBy    String?  @map("granted_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // One live grant per person, role and scope is a partial unique index over
  // COALESCE(scope_id, ...) WHERE revoked_at IS NULL, added in
  // migrations/20261004170000_one_live_grant. Prisma cannot express it, so it
  // lives in SQL. The table-wide unique that used to sit here also counted
  // revoked rows, so a revoked grant could never be given again; it was
  // dropped in 20261012120000_regrant_after_revoke.
  @@index([userId, revokedAt])
  @@map("user_roles")
  @@schema("identity")
}

enum ScopeType {
  PLATFORM
  FACILITY_GROUP
  FACILITY
  BRANCH
  DEPARTMENT
  SELF

  @@schema("identity")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  stepUpAt       DateTime? @map("step_up_at")
  expiresAt      DateTime @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
  @@schema("identity")
}

model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  label      String?
  platform   String?
  pushToken  String?  @map("push_token")
  lastSeenAt DateTime? @map("last_seen_at")
  trustedAt  DateTime? @map("trusted_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
  @@schema("identity")
}

model OtpCode {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  purpose    OtpPurpose
  codeHash   String   @map("code_hash")
  expiresAt  DateTime @map("expires_at")
  attempts   Int      @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  // The network address the request came from, so sends can be counted per
  // source as well as per person. Null when the request carried none.
  requestIp  String?  @map("request_ip")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([requestIp, createdAt])
  @@index([createdAt])
  @@map("otp_codes")
  @@schema("identity")
}

enum OtpPurpose {
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  LOGIN
  PASSWORD_RESET
  STEP_UP

  @@schema("identity")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  identifier String
  succeeded  Boolean
  ipAddress  String?  @map("ip_address")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, createdAt])
  @@map("login_attempts")
  @@schema("identity")
}

// ---------------------------------------------------------------- audit

// Append-only. No update or delete path exists in application code, the database
// refuses one (migration 20261016130000_audit_log_append_only, AUD-06), and the
// test harness fails the suite if a state change leaves no row here.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  actorType     String   @default("user") @map("actor_type")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  scopeType     String?  @map("scope_type")
  scopeId       String?  @map("scope_id") @db.Uuid
  reason        String?
  before        Json?
  after         Json?
  correlationId String?  @map("correlation_id")
  requestId     String?  @map("request_id")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([correlationId])
  @@index([createdAt, id])
  @@index([scopeType, scopeId, createdAt, id])
  @@map("audit_log")
  @@schema("audit")
}

// Transactional outbox. Events are written in the same transaction as the
// state change, so an event cannot be lost when a consumer fails.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  correlationId String?   @map("correlation_id")
  idempotencyKey String?  @unique @map("idempotency_key")
  status        OutboxStatus @default(PENDING)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  availableAt   DateTime  @default(now()) @map("available_at")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("outbox_events")
  @@schema("audit")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER

  @@schema("audit")
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  kind      String
  severity  String   @default("info")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@map("security_events")
  @@schema("audit")
}

// ---------------------------------------------------------------- config

// Controlled vocabularies. Every list has a named owner, because an
// unowned configuration list rots. Loaded by migration and seed only.
model ProfessionalCategory {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String
  regulator String
  isActive  Boolean  @default(true) @map("is_active")
  owner     String
  createdAt DateTime @default(now()) @map("created_at")

  specialties Specialty[]
  credentialRequirements CredentialRequirement[]
  serviceRequests ServiceRequest[]
  practitionerProfiles PractitionerProfile[]
  cadreLevels CadreLevel[]

  @@map("professional_categories")
  @@schema("config")
}

// A rung within a profession: house officer, medical officer, registrar, consultant.
// What the rungs are is the regulators' to say and compliance's to enter (CFG-04); no
// level ships with the product. `rank` orders them within one profession, 1 the most
// junior, and is never compared across professions. Retired, not deleted: a level a
// shift or a practitioner already holds must keep meaning what it meant.
model CadreLevel {
  id                     String   @id @default(uuid()) @db.Uuid
  professionalCategoryId String   @map("professional_category_id") @db.Uuid
  /// `<profession key>.<slug of the name>`, unique, and what a client names.
  key                    String   @unique
  name                   String
  rank                   Int
  isActive               Boolean  @default(true) @map("is_active")
  owner                  String
  createdAt              DateTime @default(now()) @map("created_at")

  category ProfessionalCategory @relation(fields: [professionalCategoryId], references: [id])
  registrations ProfessionalRegistration[]
  serviceRequests ServiceRequest[]

  @@unique([professionalCategoryId, rank])
  @@map("cadre_levels")
  @@schema("config")
}

// How a practitioner stands on the register: full, provisional, intern, post-basic.
// `supervisionRequired` is what makes the rest of the platform treat somebody on it
// as supervised: they can be offered only shifts that say supervision is available.
model RegistrationCategory {
  id                  String   @id @default(uuid()) @db.Uuid
  key                 String   @unique
  name                String
  supervisionRequired Boolean  @default(false) @map("supervision_required")
  isActive            Boolean  @default(true) @map("is_active")
  owner               String
  createdAt           DateTime @default(now()) @map("created_at")

  registrations ProfessionalRegistration[]

  @@map("registration_categories")
  @@schema("config")
}

model Specialty {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  key        String   @unique
  name       String
  isActive   Boolean  @default(true) @map("is_active")
  owner      String
  createdAt  DateTime @default(now()) @map("created_at")

  category ProfessionalCategory @relation(fields: [categoryId], references: [id])
  practitionerProfiles PractitionerProfile[]
  serviceRequests ServiceRequest[]

  @@map("specialties")
  @@schema("config")
}

model CredentialType {
  id            String  @id @default(uuid()) @db.Uuid
  key           String  @unique
  name          String
  issuer        String
  isMandatory   Boolean @default(false) @map("is_mandatory")
  expires       Boolean @default(true)
  reviewDays    Int     @default(365) @map("review_days")
  verificationMethod String @map("verification_method")
  owner         String
  createdAt     DateTime @default(now()) @map("created_at")

  submissions CredentialSubmission[]
  requirements CredentialRequirement[]

  @@map("credential_types")
  @@schema("config")
}

model State {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  zone      String
  owner     String
  createdAt DateTime @default(now()) @map("created_at")

  lgas Lga[]
  practitionerProfiles PractitionerProfile[]
  facilities Facility[]

  @@map("states")
  @@schema("config")
}

model Lga {
  id        String   @id @default(uuid()) @db.Uuid
  stateId   String   @map("state_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)
  facilities Facility[]
  practitionerProfiles PractitionerProfile[]

  @@unique([stateId, name])
  @@map("lgas")
  @@schema("config")
}

model FacilityType {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String
  regulator String
  owner     String
  createdAt DateTime @default(now()) @map("created_at")

  facilities Facility[]

  @@map("facility_types")
  @@schema("config")
}

model PublicHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  name      String
  year      Int
  owner     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date, name])
  @@map("public_holidays")
  @@schema("config")
}

// Rate floors exist from day one so a shift can never be published below
// a defensible minimum. Money is stored in kobo as an integer.
model RateFloor {
  id            String   @id @default(uuid()) @db.Uuid
  categoryKey   String   @map("category_key")
  specialtyKey  String   @default("*") @map("specialty_key")
  /// `*` for every level; otherwise a `config.cadre_levels.key` of this profession (REQ-01).
  cadreLevelKey String   @default("*") @map("cadre_level_key")
  shiftType     String   @map("shift_type")
  minHourlyKobo Int      @map("min_hourly_kobo")
  currency      String   @default("NGN")
  effectiveFrom DateTime @map("effective_from")
  owner         String
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([categoryKey, specialtyKey, cadreLevelKey, shiftType, effectiveFrom])
  @@map("rate_floors")
  @@schema("config")
}

// ---------------------------------------------------------------- storage

// One row per object held in Tigris. The bytes are never in PostgreSQL:
// this table records the key, integrity data and who may retrieve it.
model StoredObject {
  id            String   @id @default(uuid()) @db.Uuid
  bucket        String
  objectKey     String   @unique @map("object_key")
  contentType   String   @map("content_type")
  sizeBytes     Int      @map("size_bytes")
  checksumSha256 String? @map("checksum_sha256")
  purpose       String
  ownerUserId   String?  @map("owner_user_id") @db.Uuid
  scopeType     String?  @map("scope_type")
  scopeId       String?  @map("scope_id") @db.Uuid
  uploadedAt    DateTime? @map("uploaded_at")
  createdAt     DateTime @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([ownerUserId, purpose])
  @@map("stored_objects")
  @@schema("storage")
}

// ------------------------------------------------------------ practitioners

// One profile per user. Identity and licence verification (NIN, practising
// licence, documents) are the credentials module's job, not this one's —
// this table holds only what a practitioner chooses to present.
model PractitionerProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  professionalCategoryId String    @map("professional_category_id") @db.Uuid
  specialtyId            String?   @map("specialty_id") @db.Uuid
  yearsOfExperience      Int       @map("years_of_experience")
  bio                    String?
  photoObjectKey         String?   @map("photo_object_key")
  homeStateId            String?   @map("home_state_id") @db.Uuid
  homeLgaId              String?   @map("home_lga_id") @db.Uuid
  // How far this practitioner is willing to travel, in the same tiers
  // proximity is scored in. Nothing here holds coordinates, so tiers are
  // the honest unit until something does.
  travelPreference       TravelPreference @default(SAME_STATE) @map("travel_preference")
  // When the practitioner said "this is complete, review it". Null until they
  // do. It orders the compliance queue — an officer works the people who have
  // asked, not everybody who has half-filled a form — and is deliberately NOT
  // an eligibility blocker: only an officer's verification gates matching.
  submittedForReviewAt   DateTime? @map("submitted_for_review_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalCategory ProfessionalCategory @relation(fields: [professionalCategoryId], references: [id])
  specialty            Specialty?           @relation(fields: [specialtyId], references: [id])
  homeState            State?               @relation(fields: [homeStateId], references: [id])
  homeLga              Lga?                 @relation(fields: [homeLgaId], references: [id])

  @@map("practitioner_profiles")
  @@schema("practitioners")
}

// ------------------------------------------------------------- credentials

// Many rows per user: a practitioner holds several credential types over
// time and may resubmit after a rejection. "Active" (not yet superseded)
// means PENDING or VERIFIED; a REJECTED row does not block a fresh
// submission of the same type.
model CredentialSubmission {
  id                String                     @id @default(uuid()) @db.Uuid
  userId            String                     @map("user_id") @db.Uuid
  credentialTypeId  String                     @map("credential_type_id") @db.Uuid
  status            CredentialSubmissionStatus @default(PENDING)
  referenceNumber   String?                    @map("reference_number")
  documentObjectKey String?                    @map("document_object_key")
  // Who last acted on it, when and why — a decision or a request for more
  // information; `status` is what says which. A bare column, not a relation —
  // matching the existing precedent of audit.security_events.user_id, which
  // also has no @relation and no back-relation on User. The audit row
  // reviewCredential writes in the same transaction is the system of record
  // for "who did this"; this is a denormalised convenience for reading a
  // submission back without a join to audit_log.
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at")
  reviewNotes String?   @map("review_notes")
  // The instant this stops counting, which the expiry sweep and the warnings
  // act on. When the reviewer read a date off the document it is the end of
  // that day in Lagos; with none read it is the review date plus the type's
  // reviewDays, and documentExpiresOn is null so every screen can say so.
  expiresAt DateTime? @map("expires_at")
  // The date printed on the document, as the reviewer read it. The one the
  // practitioner is shown (CRE-04).
  documentExpiresOn DateTime? @map("document_expires_on") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialType CredentialType @relation(fields: [credentialTypeId], references: [id])

  @@index([userId, credentialTypeId])
  @@index([status])
  @@map("credential_submissions")
  @@schema("credentials")
}

enum CredentialSubmissionStatus {
  PENDING
  // The reviewer needs something more before deciding. The practitioner can
  // resupply from here and the row returns to PENDING; it is the only state
  // a submission can be edited from.
  MORE_INFO_REQUESTED
  VERIFIED
  REJECTED
  // Was VERIFIED, then its expiry passed. A separate state from REJECTED:
  // nobody judged it wanting, and the practitioner renews rather than
  // re-argues it.
  EXPIRED

  @@schema("credentials")
}

// ---------------------------------------------------------------- facilities

// A facility is an organisation, not a person, so it is created by Medilink
// operations rather than self-declared: verification exists precisely to stop
// anyone claiming to be a hospital. The named representative is granted
// facility_owner over this facility at creation, in the same transaction.
model Facility {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  facilityTypeId String  @map("facility_type_id") @db.Uuid
  // What the facility is registered under, and which register that is. The column
  // is still called cac_number and still holds a CAC number for a company; for a
  // government facility it holds the ministry's or the board's reference.
  // Unique per kind at the database level, not checked in application code: step
  // 5.4 asks for a duplicate to be refused "on the constraint, not in code".
  registrationKind RegistrationKind @default(CAC) @map("registration_kind")
  cacNumber      String  @map("cac_number")

  stateId     String  @map("state_id") @db.Uuid
  lgaId       String? @map("lga_id") @db.Uuid
  addressLine String  @map("address_line")

  contactPhone String  @map("contact_phone")
  contactEmail String? @map("contact_email")

  representativeUserId String @map("representative_user_id") @db.Uuid

  status FacilityStatus @default(PENDING)

  licenceNumber    String?   @map("licence_number")
  licenceObjectKey String?   @map("licence_object_key")
  // Read by canPublish() at publish time, which needs no scheduler. The
  // automatic suspension of step 5.9 does, and does not exist yet.
  licenceExpiresAt DateTime? @map("licence_expires_at")

  // Who verified it, when and why. A bare column, not a Prisma relation,
  // matching CredentialSubmission.reviewedBy: the audit row written in the
  // same transaction is the system of record for "who did this".
  verifiedBy  String?   @map("verified_by") @db.Uuid
  verifiedAt  DateTime? @map("verified_at")
  reviewNotes String?   @map("review_notes")
  /// What the officer confirmed before approving: the licence seen, matching, the
  /// registration checked, and how.
  verificationChecks Json? @map("verification_checks")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  serviceRequests ServiceRequest[]
  incidents       ClinicalIncident[]
  rateCards       RateCard[]
  invoices        Invoice[]

  facilityType FacilityType @relation(fields: [facilityTypeId], references: [id])
  state        State        @relation(fields: [stateId], references: [id])
  lga          Lga?         @relation(fields: [lgaId], references: [id])
  // Restrict, not Cascade: removing the person must never silently remove the
  // organisation they happened to represent.
  representative User @relation(fields: [representativeUserId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([stateId, status])
  @@index([representativeUserId])
  @@unique([registrationKind, cacNumber])
  @@map("facilities")
  @@schema("facilities")
}

/// Which register a facility's reference is from. A company has a CAC number; a
/// government hospital or primary health centre has a ministry or state board
/// reference instead.
enum RegistrationKind {
  CAC
  GOVERNMENT
  OTHER

  @@schema("facilities")
}

enum FacilityStatus {
  PENDING
  VERIFIED
  REJECTED
  // Reachable by no code path in this cut. It exists because canPublish must
  // decide on it, and because step 5.9 (expiry) and module 15 (clinical
  // incidents) both suspend a facility rather than delete it.
  SUSPENDED

  @@schema("facilities")
}

// Scheduled jobs. The sweeps Stage 5 needs — credential expiry, sanctions
// screening, eligibility recomputation — and the ones Stage 7 will need. Runs
// in the same worker process as the outbox, claimed the same way, because the
// stack decision is "Postgres outbox plus worker; Redis/BullMQ only if
// needed" and this needs neither.
model ScheduledJob {
  id              String    @id @default(uuid()) @db.Uuid
  key             String    @unique
  description     String
  intervalSeconds Int       @map("interval_seconds")
  // An operator's off switch: a sweep misbehaving in production is disabled
  // in one row, without a deploy.
  enabled         Boolean   @default(true)
  nextRunAt       DateTime  @default(now()) @map("next_run_at")
  lastRunAt       DateTime? @map("last_run_at")
  lastStatus      ScheduledJobStatus? @map("last_status")
  lastError       String?   @map("last_error")
  lastDurationMs  Int?      @map("last_duration_ms")
  failureCount    Int       @default(0) @map("failure_count")
  runCount        Int       @default(0) @map("run_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([enabled, nextRunAt])
  @@map("scheduled_jobs")
  @@schema("audit")
}

enum ScheduledJobStatus {
  SUCCEEDED
  FAILED

  @@schema("audit")
}

// Step 5.3 and 5.4. The National Identification Number itself is never
// stored: the column holds an HMAC keyed with SESSION_SECRET, for the same
// reason one-time codes do (docs/stage-4-2-auth.md) — an eleven-digit number
// under an unkeyed hash is reversible by exhaustive search in seconds, and a
// leaked table would then be a list of everyone's NIN.
//
// nin_hash carries the unique constraint, so a duplicate identity is refused
// by the database rather than by a prior read. There is deliberately no
// column named `nin`, and no raw value is ever logged or returned.
model IdentityVerification {
  id                  String                     @id @default(uuid()) @db.Uuid
  userId              String                     @unique @map("user_id") @db.Uuid
  ninHash             String                     @unique @map("nin_hash")
  // The last four digits, which is what a reviewer needs to talk to a
  // practitioner about their record without holding the number.
  ninLast4            String                     @map("nin_last4")
  nameMatch           Boolean                    @map("name_match")
  method              IdentityVerificationMethod
  verifiedBy          String?                    @map("verified_by") @db.Uuid
  verifiedAt          DateTime                   @map("verified_at")
  evidenceRetrievedAt DateTime                   @map("evidence_retrieved_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_verifications")
  @@schema("practitioners")
}

enum IdentityVerificationMethod {
  // A compliance officer read the slip and recorded it. The only path while
  // NIN_VERIFICATION_PROVIDER is `none`, which is the default.
  MANUAL
  NIMC

  @@schema("practitioners")
}

// Step 5.5: what the regulator says about this practitioner, and when we
// last looked. The retrieval date is the point — evidence without a date
// cannot be judged stale, and a licence checked two years ago is not
// evidence that someone may work a shift tomorrow.
model ProfessionalRegistration {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  regulator           String
  folioNumber         String             @unique @map("folio_number")
  practiceType        String?            @map("practice_type")
  registrationStatus  RegistrationStatus @map("registration_status")
  location            String?
  // Where they stand, as the officer read it from the register (PRA-01, PRA-02). Null
  // until somebody records it, and only ever one a profession actually has.
  cadreLevelId           String? @map("cadre_level_id") @db.Uuid
  registrationCategoryId String? @map("registration_category_id") @db.Uuid
  evidenceRetrievedAt DateTime           @map("evidence_retrieved_at")
  expiresAt           DateTime?          @map("expires_at")
  source              VerificationSource
  recordedBy          String?            @map("recorded_by") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cadreLevel           CadreLevel?           @relation(fields: [cadreLevelId], references: [id])
  registrationCategory RegistrationCategory? @relation(fields: [registrationCategoryId], references: [id])

  // One registration per regulator per practitioner: a doctor holds one MDCN
  // folio, not several.
  @@unique([userId, regulator])
  @@index([registrationStatus])
  @@index([expiresAt])
  @@map("professional_registrations")
  @@schema("practitioners")
}

enum RegistrationStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  STRUCK_OFF
  // The regulator was unreachable or gave an answer we could not read. Never
  // treated as good news by the eligibility rule.
  UNKNOWN

  @@schema("practitioners")
}

enum VerificationSource {
  MANUAL
  REGULATOR_API

  @@schema("practitioners")
}

// Step 5.6: the sanctioned and "quack" lists a practitioner is screened
// against. Seeded empty with a named owner — the real lists are compliance's
// to supply, and an invented one would be worse than none.
model SanctionedEntry {
  id             String             @id @default(uuid()) @db.Uuid
  sourceList     SanctionSourceList @map("source_list")
  fullName       String             @map("full_name")
  // The comparable form, computed once on write so a sweep over every
  // practitioner is an indexed lookup rather than a scan that normalises as
  // it goes.
  normalisedName String             @map("normalised_name")
  folioNumber    String?            @map("folio_number")
  reason         String?
  listedAt       DateTime           @map("listed_at")
  owner          String
  createdAt      DateTime           @default(now()) @map("created_at")

  screenings ScreeningResult[]

  @@index([normalisedName])
  @@index([folioNumber])
  @@map("sanctioned_entries")
  @@schema("config")
}

enum SanctionSourceList {
  MDCN_QUACK_LIST
  MDCN_SANCTIONS
  // Someone Medilink itself has barred, after an incident or a dispute.
  INTERNAL

  @@schema("config")
}

model ScreeningResult {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @unique @map("user_id") @db.Uuid
  status         ScreeningStatus
  matchedEntryId String?         @map("matched_entry_id") @db.Uuid
  /// 'name' or 'folio' — which field matched, so a reviewer knows what to check.
  matchedOn      String?         @map("matched_on")
  screenedAt     DateTime        @map("screened_at")
  // A compliance officer's override of a false positive. Two people with the
  // same name is common enough that a flag has to be answerable.
  clearedBy      String?         @map("cleared_by") @db.Uuid
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchedEntry SanctionedEntry? @relation(fields: [matchedEntryId], references: [id])

  @@index([status])
  @@map("screening_results")
  @@schema("practitioners")
}

enum ScreeningStatus {
  // Never screened, or screened against a list that has since changed. Not
  // the same as CLEAR, and the eligibility rule refuses it.
  PENDING
  CLEAR
  FLAGGED

  @@schema("practitioners")
}

// Step 5.8: which credentials each professional category actually requires.
//
// This replaces CredentialType.isMandatory, which was a single global flag on
// a doctor-shaped list — under it a nurse appeared to need an MDCN practising
// licence and an MBBS certificate. Building an eligibility rule on that would
// have been actively wrong rather than merely incomplete.
//
// Owner: Compliance. Partial in the same way the state and LGA lists are.
model CredentialRequirement {
  id                     String   @id @default(uuid()) @db.Uuid
  professionalCategoryId String   @map("professional_category_id") @db.Uuid
  credentialTypeId       String   @map("credential_type_id") @db.Uuid
  isMandatory            Boolean  @default(true) @map("is_mandatory")
  owner                  String
  createdAt              DateTime @default(now()) @map("created_at")

  professionalCategory ProfessionalCategory @relation(fields: [professionalCategoryId], references: [id], onDelete: Cascade)
  credentialType       CredentialType       @relation(fields: [credentialTypeId], references: [id], onDelete: Cascade)

  @@unique([professionalCategoryId, credentialTypeId])
  @@index([professionalCategoryId, isMandatory])
  @@map("credential_requirements")
  @@schema("config")
}

// How far a practitioner will travel, in the tiers proximity is scored in.
enum TravelPreference {
  SAME_LGA
  SAME_STATE
  ANYWHERE

  @@schema("practitioners")
}

// ------------------------------------------------------------- availability

// Step 6.2. One table for both shapes of availability, because both answer
// the same question — "is this practitioner free for this window?" — and a
// matcher that had to union two tables would drift between them.
//
// Recurring times are minutes since midnight in WAT (UTC+1, no DST), which is
// how a practitioner thinks about them. The conversion lives in one place,
// domain/availability.ts; storing local minutes and comparing them in UTC is
// the bug that shape avoids.
model AvailabilitySlot {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @map("user_id") @db.Uuid
  kind   AvailabilityKind

  // RECURRING_WEEKLY. 0 is Sunday, matching JavaScript's getUTCDay.
  dayOfWeek      Int?      @map("day_of_week")
  startMinute    Int?      @map("start_minute")
  // An end at or before the start means the slot runs past midnight.
  endMinute      Int?      @map("end_minute")
  effectiveFrom  DateTime? @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")

  // ONE_OFF
  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("availability_slots")
  @@schema("availability")
}

enum AvailabilityKind {
  RECURRING_WEEKLY
  ONE_OFF

  @@schema("availability")
}

// Leave, a conference, a shift already worked elsewhere. A block always beats
// a slot: saying "I am free on Tuesdays" and "I am away this Tuesday" is not
// a contradiction, and the second is the more specific statement.
model BlockedPeriod {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  startsAt  DateTime  @map("starts_at")
  endsAt    DateTime  @map("ends_at")
  reason    String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@map("blocked_periods")
  @@schema("availability")
}

// ---------------------------------------------------------- service requests

// Step 6.1. A facility's stated need: who, when, at what rate, and on what
// cancellation terms.
model ServiceRequest {
  id                     String  @id @default(uuid()) @db.Uuid
  facilityId             String  @map("facility_id") @db.Uuid
  professionalCategoryId String  @map("professional_category_id") @db.Uuid
  specialtyId            String? @map("specialty_id") @db.Uuid
  // The level the shift is for, when the profession has levels (REQ-01). Only somebody
  // recorded at exactly this level is offered it. Null for a profession with none defined.
  cadreLevelId           String? @map("cadre_level_id") @db.Uuid
  // Whether somebody is there to supervise. A practitioner on a register that needs
  // supervision can be offered only a shift that says so.
  supervisionAvailable   Boolean @default(false) @map("supervision_available")

  shiftType ShiftType @map("shift_type")
  startsAt  DateTime  @map("starts_at")
  endsAt    DateTime  @map("ends_at")
  // Facilities staff wards in threes. The request stays open until this many
  // assignments are confirmed against it.
  headcount Int       @default(1)

  // Integer kobo, never a float (rule 3). Checked against config.rate_floors
  // at creation and again at publish, because a floor can move in between.
  hourlyRateKobo Int    @map("hourly_rate_kobo")
  currency       String @default("NGN")

  urgency           RequestUrgency @default(ROUTINE)
  cancellationTerms String         @map("cancellation_terms")
  notes             String?

  status             ServiceRequestStatus @default(DRAFT)
  createdBy          String               @map("created_by") @db.Uuid
  publishedBy        String?              @map("published_by") @db.Uuid
  publishedAt        DateTime?            @map("published_at")
  cancelledAt        DateTime?            @map("cancelled_at")
  cancellationReason String?              @map("cancellation_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  matchRuns   MatchRun[]
  assignments Assignment[]

  facility             Facility             @relation(fields: [facilityId], references: [id])
  professionalCategory ProfessionalCategory @relation(fields: [professionalCategoryId], references: [id])
  specialty            Specialty?           @relation(fields: [specialtyId], references: [id])
  cadreLevel           CadreLevel?          @relation(fields: [cadreLevelId], references: [id])

  @@index([status, startsAt])
  // A facility's shifts by status in start order, a page at a time.
  @@index([facilityId, status, startsAt, id])
  @@map("service_requests")
  @@schema("service_requests")
}

// Uppercase here, lowercase in config.rate_floors.shift_type, which predates
// this model. The lookup lowercases; see domain/rate-floor.ts.
enum ShiftType {
  DAY
  NIGHT

  @@schema("service_requests")
}

enum RequestUrgency {
  ROUTINE
  URGENT
  EMERGENCY

  @@schema("service_requests")
}

enum ServiceRequestStatus {
  DRAFT
  PUBLISHED
  // Headcount reached. Still readable, no longer matchable.
  FILLED
  CANCELLED
  // The shift started and it was never filled.
  EXPIRED

  @@schema("service_requests")
}

// ------------------------------------------------------------------ matching

// Step 6.3 requires match results to be explainable: "for any candidate, why
// they ranked where they did". That has to survive the request that produced
// it, so a run is persisted with every candidate's factors and every excluded
// candidate's reasons.
model MatchRun {
  id               String @id @default(uuid()) @db.Uuid
  serviceRequestId String @map("service_request_id") @db.Uuid
  runBy            String? @map("run_by") @db.Uuid
  consideredCount  Int     @map("considered_count")
  rankedCount      Int     @map("ranked_count")
  // The weights in force when this ran. Without them an old ranking cannot be
  // read back once the weights change, and "why did they rank there" becomes
  // unanswerable for exactly the runs anyone would want to question.
  weights          Json
  createdAt        DateTime @default(now()) @map("created_at")

  serviceRequest ServiceRequest   @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  candidates     MatchCandidate[]

  @@index([serviceRequestId, createdAt])
  @@map("match_runs")
  @@schema("matching")
}

model MatchCandidate {
  id         String  @id @default(uuid()) @db.Uuid
  matchRunId String  @map("match_run_id") @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  // Null for an excluded candidate: they have no rank because they were never
  // in the running.
  rank       Int?
  score      Float?
  factors    Json?
  exclusions String[]
  createdAt  DateTime @default(now()) @map("created_at")

  matchRun MatchRun @relation(fields: [matchRunId], references: [id], onDelete: Cascade)

  @@index([matchRunId, rank])
  @@map("match_candidates")
  @@schema("matching")
}

// Steps 6.5 to 6.7. Created here so the matcher's conflict check has
// something real to query from the moment it exists; the lifecycle that
// fills it follows.
model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  serviceRequestId String           @map("service_request_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  matchRunId       String?          @map("match_run_id") @db.Uuid
  status           InvitationStatus @default(INVITED)
  expiresAt        DateTime         @map("expires_at")
  respondedAt      DateTime?        @map("responded_at")
  declineReason    String?          @map("decline_reason")
  invitedBy        String?          @map("invited_by") @db.Uuid
  // What the practitioner was shown when they accepted: cancellation terms,
  // notes, address, rate and times, copied at that moment. The request's own
  // columns can be read later but they are not what was agreed if anything
  // moved in between. Null until accepted, and cleared when an offer is made
  // again, so one acceptance cannot stand for the next offer.
  termsAccepted    Json?            @map("terms_accepted")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // One live invitation per practitioner per request.
  @@unique([serviceRequestId, userId])
  @@index([userId, status])
  @@map("invitations")
  @@schema("matching")
}

enum InvitationStatus {
  INVITED
  ACCEPTED
  DECLINED
  EXPIRED
  // Closed without becoming an assignment: the request filled, was cancelled
  // or expired first. An accepted offer the facility never confirmed ends here
  // too. Opened again by a fresh invitation if the shift reopens.
  WITHDRAWN

  @@schema("matching")
}

model Assignment {
  id               String           @id @default(uuid()) @db.Uuid
  serviceRequestId String           @map("service_request_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  facilityId       String           @map("facility_id") @db.Uuid
  startsAt         DateTime         @map("starts_at")
  endsAt           DateTime         @map("ends_at")
  status           AssignmentStatus @default(CONFIRMED)
  confirmedBy      String           @map("confirmed_by") @db.Uuid
  // The facility's allowances (night, holiday, overtime, on-call multipliers)
  // as they stood when this was booked, with the card they came from. What the
  // shift is priced on, so a card replaced afterwards cannot change what was
  // agreed. Null on bookings made before this existed.
  rateTerms        Json?            @map("rate_terms")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  serviceRequest ServiceRequest            @relation(fields: [serviceRequestId], references: [id])
  user           User                      @relation(fields: [userId], references: [id])
  history        AssignmentStatusHistory[]
  attendance     AttendanceRecord?
  unhonoured     UnhonouredAssignment?
  excusals       Excusal[]
  disputes       Dispute[]
  incidents      ClinicalIncident[]

  // A practitioner is confirmed onto a given request once.
  @@unique([serviceRequestId, userId])
  // The conflict check reads this: everything this practitioner is committed
  // to, by time.
  @@index([userId, startsAt, endsAt])
  @@index([facilityId, startsAt])
  // A roster or a schedule filtered by status ("confirmed", "completed") and
  // read in start order. The two above cannot serve that without reading and
  // discarding every other status, and `facilityId, startsAt` is kept because
  // the unfiltered roster, the default, would otherwise sort a whole facility's
  // history to return one page.
  @@index([facilityId, status, startsAt, id])
  @@index([userId, status, startsAt, id])
  @@map("assignments")
  @@schema("matching")
}

enum AssignmentStatus {
  CONFIRMED
  CANCELLED
  // Reached in Stage 7, when attendance says what actually happened.
  COMPLETED
  NO_SHOW

  @@schema("matching")
}

// Step 6.6: "every change records actor and reason". Both are required
// columns rather than a convention, so the schema enforces it and nobody has
// to remember.
model AssignmentStatusHistory {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  fromStatus   AssignmentStatus? @map("from_status")
  toStatus     AssignmentStatus @map("to_status")
  actorId      String           @map("actor_id") @db.Uuid
  reason       String
  createdAt    DateTime         @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
  @@map("assignment_status_history")
  @@schema("matching")
}

// -------------------------------------------------------------- notifications

// Step 6.5 requires that both parties are notified on confirmation, and an
// assertion about a record is worth more than one about a mock. Delivery goes
// through the existing SMS adapter; this is what was sent, to whom, and when.
model NotificationMessage {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  channel     String
  kind        String
  // Masked, never the full number: this table is read by more people than
  // identity.users is, for the same reason the audit trail carries no NIN.
  recipient   String
  body        String
  relatedType String?   @map("related_type")
  relatedId   String?   @map("related_id") @db.Uuid
  sentAt      DateTime? @map("sent_at")
  failureReason String? @map("failure_reason")
  // The gateway that took the message and the id it gave it (M16-05). Null for a
  // message nobody took. `failedOverFrom` names the gateway that failed first when a
  // second one had to take over.
  provider           String?   @map("provider")
  providerMessageId  String?   @map("provider_message_id")
  failedOverFrom     String?   @map("failed_over_from")
  // What the gateway later reported: PENDING, DELIVERED or FAILED. Null is no report,
  // which is all there is until a gateway has been told where to send them.
  deliveryStatus     String?   @map("delivery_status")
  deliveryReportedAt DateTime? @map("delivery_reported_at")
  deliveryDetail     String?   @map("delivery_detail")
  // When the person opened it in the app's inbox. Null is unread (UXP-01).
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([provider, providerMessageId])
  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([relatedType, relatedId])
  @@index([userId, kind, relatedId])
  @@map("messages")
  @@schema("notifications")
}

// ------------------------------------------------------------- attendance

// Step 7.1. One record per assignment, carrying the nine states of Section
// 9.16. Every transition goes through domain/state-machine.ts, which is what
// makes "attendance cannot reach an illegal state through any code path" a
// property of the code rather than a hope.
model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @unique @map("assignment_id") @db.Uuid
  status       AttendanceState  @default(NOT_STARTED)

  checkedInAt  DateTime? @map("checked_in_at")
  checkedOutAt DateTime? @map("checked_out_at")
  // Unpaid time within the shift, deducted before hours are billed.
  breakMinutes Int       @default(0) @map("break_minutes")

  submittedAt DateTime? @map("submitted_at")
  submittedBy String?   @map("submitted_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at")
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  // Mandatory on a rejection; a rejection nobody can act on is worse than none.
  reviewNotes String?   @map("review_notes")

  // What the record was in when a dispute was opened over it, so a dismissed
  // dispute can put it back exactly there rather than guessing. Attendance
  // owns this because the state machine is attendance's invariant; the
  // disputes module holds the case, not the record's history.
  preDisputeStatus AttendanceState? @map("pre_dispute_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignment Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  events     CheckInEvent[]
  tokens     CheckInToken[]
  timesheet  Timesheet?

  @@index([status])
  @@map("attendance_records")
  @@schema("attendance")
}

enum AttendanceState {
  NOT_STARTED
  CHECK_IN_PENDING
  CHECKED_IN
  CHECKED_OUT
  SUBMITTED
  APPROVED
  REJECTED
  // Module 14 is Stage 8; nothing moves a record out of here yet.
  DISPUTED
  MANUALLY_CORRECTED

  @@schema("attendance")
}

// Append-only. The record holds the current state; this holds how it got
// there, which is what a dispute months later actually needs.
model CheckInEvent {
  id                 String            @id @default(uuid()) @db.Uuid
  attendanceRecordId String            @map("attendance_record_id") @db.Uuid
  kind               CheckInEventKind
  method             CheckInMethod
  actorId            String            @map("actor_id") @db.Uuid
  occurredAt         DateTime          @map("occurred_at")
  recordedAt         DateTime          @default(now()) @map("recorded_at")
  // Mandatory for a MANUAL method: step 7.3's whole point.
  reason             String?
  deviceLabel        String?           @map("device_label")

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  actor            User             @relation(fields: [actorId], references: [id])

  @@index([attendanceRecordId, recordedAt])
  @@map("checkin_events")
  @@schema("attendance")
}

enum CheckInEventKind {
  CHECK_IN
  CHECK_OUT

  @@schema("attendance")
}

enum CheckInMethod {
  // The six-digit code a supervisor reads out.
  SUPERVISOR_CODE
  // The same secret, scanned.
  QR
  // No token could be exchanged; a supervisor recorded it afterwards.
  MANUAL

  @@schema("attendance")
}

// The short-lived secret behind both the supervisor code and the QR — see
// domain/check-in-token.ts. Stored as an HMAC keyed with SESSION_SECRET, for
// the reason one-time codes are: six digits is reversible under a bare hash.
model CheckInToken {
  id                 String           @id @default(uuid()) @db.Uuid
  attendanceRecordId String           @map("attendance_record_id") @db.Uuid
  purpose            CheckInEventKind
  codeHash           String           @map("code_hash")
  expiresAt          DateTime         @map("expires_at")
  attempts           Int              @default(0)
  consumedAt         DateTime?        @map("consumed_at")
  issuedBy           String           @map("issued_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([attendanceRecordId, purpose, consumedAt])
  @@map("checkin_tokens")
  @@schema("attendance")
}

// ------------------------------------------------------------- timesheets

// Step 7.4. Hours are classified into bands and priced at the rate both
// parties already agreed on the request. The allowance multipliers for night,
// weekend and overtime are module 10, which is Stage 8 — inventing them here
// would be setting commercial terms.
model Timesheet {
  id                 String @id @default(uuid()) @db.Uuid
  attendanceRecordId String @unique @map("attendance_record_id") @db.Uuid

  // Minutes, not hours: an integer avoids the rounding argument entirely, and
  // a shift is never billed in fractions of a minute.
  workedMinutes   Int @map("worked_minutes")
  breakMinutes    Int @map("break_minutes")
  billableMinutes Int @map("billable_minutes")

  // Bands. They sum to billableMinutes; overtime and holiday overlap the
  // others by design, so they are recorded separately rather than summed.
  nightMinutes    Int @map("night_minutes")
  overtimeMinutes Int @map("overtime_minutes")
  holidayMinutes  Int @map("holiday_minutes")
  onCallMinutes   Int @default(0) @map("on_call_minutes")

  // Night minutes that are not also holiday minutes. night_minutes and
  // holiday_minutes overlap, so the exact split cannot be rebuilt from them;
  // holiday takes precedence, which makes holiday_minutes the holiday bucket
  // and this the night bucket. Ordinary is what is left of billable_minutes.
  nightOnlyMinutes Int @default(0) @map("night_only_minutes")

  // Integer kobo (rule 3), at the request's agreed hourly rate.
  hourlyRateKobo Int @map("hourly_rate_kobo")
  amountKobo     Int @map("amount_kobo")
  currency       String @default("NGN")

  // Bumped by every correction; revisions carry what it was before.
  revision  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attendanceRecord AttendanceRecord    @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  revisions        TimesheetRevision[]

  @@map("timesheets")
  @@schema("timesheets")
}

// Step 7.6: "no correction destroys the value it replaces". A correction
// writes one of these and never overwrites — the previous values, the actor
// and the reason all survive, linked to the timesheet they belonged to.
model TimesheetRevision {
  id          String   @id @default(uuid()) @db.Uuid
  timesheetId String   @map("timesheet_id") @db.Uuid
  revision    Int
  // The whole previous state, not a diff: a diff can only be read against a
  // history nobody kept.
  previous    Json
  actorId     String   @map("actor_id") @db.Uuid
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@unique([timesheetId, revision])
  @@index([timesheetId, createdAt])
  @@map("timesheet_revisions")
  @@schema("timesheets")
}

// ------------------------------------------------ cancellations_sanctions

// Step 7.7. A sweep finds assignments nobody honoured; a *person* decides
// whose fault it was. Nothing closes itself and nothing accuses a
// practitioner unreviewed — an absence has a dozen innocent explanations, and
// the platform cannot tell them apart from a database row.
model UnhonouredAssignment {
  id           String @id @default(uuid()) @db.Uuid
  assignmentId String @unique @map("assignment_id") @db.Uuid

  // Why it was flagged, recorded when it was: the shift ended and attendance
  // never started.
  shiftEndedAt DateTime @map("shift_ended_at")
  detectedAt   DateTime @default(now()) @map("detected_at")

  status UnhonouredStatus @default(AWAITING_DECISION)

  // Null until somebody decides. The gate condition is that no unhonoured
  // assignment reaches a final state without a fault value, and this column
  // being nullable while `status` is AWAITING_DECISION is what makes the
  // absence visible rather than implied.
  fault     Fault?
  decidedBy String?   @map("decided_by") @db.Uuid
  decidedAt DateTime? @map("decided_at")
  reason    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([status, detectedAt])
  @@map("unhonoured_assignments")
  @@schema("cancellations_sanctions")
}

enum UnhonouredStatus {
  AWAITING_DECISION
  CLOSED

  @@schema("cancellations_sanctions")
}

enum Fault {
  PRACTITIONER
  FACILITY
  // Neither: the shift did not happen and nobody is answerable for it.
  // A real outcome, not a way of avoiding the question.
  NEITHER

  @@schema("cancellations_sanctions")
}

// Step 7.8. A practitioner asks to be excused; an officer grants or refuses.
// Not unique per assignment: **both outcomes are retained**, so a refusal is
// still on the record when a later request is granted. Nothing is deleted and
// nothing is overwritten.
model Excusal {
  id           String @id @default(uuid()) @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid
  requestedBy  String @map("requested_by") @db.Uuid
  reason       String

  status        ExcusalStatus @default(REQUESTED)
  decidedBy     String?       @map("decided_by") @db.Uuid
  decidedAt     DateTime?     @map("decided_at")
  // Mandatory on a refusal, for the reason a timesheet rejection's is.
  decisionNotes String?       @map("decision_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
  @@index([status])
  @@map("excusals")
  @@schema("cancellations_sanctions")
}

enum ExcusalStatus {
  REQUESTED
  GRANTED
  REFUSED

  @@schema("cancellations_sanctions")
}

// ----------------------------------------------------------------- disputes

// Module 14. A case opened over a shift that has already been decided —
// approved or rejected — by whichever party disagrees with the outcome.
//
// The case lives here; the attendance record's *state* stays attendance's,
// reached through its application layer. The two are not the same thing: a
// dispute can be withdrawn, refused as out of time, or resolved either way,
// and none of that is the shift's state machine's business.
model Dispute {
  id           String @id @default(uuid()) @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid

  // Who is complaining, and on which side. The party matters at resolution:
  // a practitioner disputing their hours and a facility disputing them are
  // the same case shape with opposite interests.
  raisedBy    String        @map("raised_by") @db.Uuid
  raisedParty DisputeParty  @map("raised_party")
  category    DisputeCategory
  reason      String

  status  DisputeStatus  @default(OPEN)
  outcome DisputeOutcome?

  // Null until somebody adjudicates. A dispute cannot be resolved without an
  // outcome and a reason, the same shape as a fault determination.
  resolvedBy      String?   @map("resolved_by") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at")
  resolutionNotes String?   @map("resolution_notes")

  withdrawnAt DateTime? @map("withdrawn_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignment Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  evidence   DisputeEvidence[]

  // Not unique per assignment: a shift can be disputed again after a
  // dismissal, on new evidence. Only one may be open at a time, which is the
  // application layer's rule because a partial index is not expressible here.
  @@index([assignmentId, createdAt])
  @@index([status, createdAt])
  @@map("disputes")
  @@schema("disputes")
}

enum DisputeParty {
  PRACTITIONER
  FACILITY

  @@schema("disputes")
}

enum DisputeCategory {
  // The times or the break are wrong.
  HOURS
  // The hours are right and the money is not.
  PAY
  // The shift did not happen as agreed: cover never arrived, ward was shut.
  NON_ATTENDANCE
  CONDUCT
  OTHER

  @@schema("disputes")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  // Withdrawn by the party that raised it. Kept, not deleted.
  WITHDRAWN

  @@schema("disputes")
}

enum DisputeOutcome {
  // The complaint was right: the figures go back to be decided again.
  UPHELD
  // The complaint was not made out: the record returns to where it was.
  DISMISSED

  @@schema("disputes")
}

// Evidence attached to a case. The file itself lives in Tigris under the
// `dispute_evidence` purpose; only its key and metadata are here, per the
// convention at the top of this schema.
model DisputeEvidence {
  id         String @id @default(uuid()) @db.Uuid
  disputeId  String @map("dispute_id") @db.Uuid
  objectKey  String @map("object_key")
  // Who attached it. Either party may, and a reader needs to know which.
  attachedBy String @map("attached_by") @db.Uuid
  note       String?

  createdAt DateTime @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@unique([disputeId, objectKey])
  @@index([disputeId, createdAt])
  @@map("dispute_evidence")
  @@schema("disputes")
}

// -------------------------------------------------------- clinical_incidents

// Module 15. A patient-safety event during or around a shift.
//
// **A report is not an accusation.** The patient-safety literature is
// unanimous that a reporting system which punishes reporters stops receiving
// reports, and a platform that learns nothing about near misses is worth less
// than one that never asked. So: near misses are first-class, nothing here is
// ever deleted, and the practitioner a report names is a `subjectUserId`
// rather than a defendant. Whether anything follows is a separate decision by
// somebody with `incident.manage`.
model ClinicalIncident {
  id String @id @default(uuid()) @db.Uuid

  // Where it happened. Always known — somebody at a facility is reporting.
  facilityId String @map("facility_id") @db.Uuid

  // The shift, when there was one. Nullable: an incident found during a
  // week-later case note review may not be traceable to a single assignment,
  // and refusing the report because the paperwork is untidy loses the report.
  assignmentId String? @map("assignment_id") @db.Uuid

  // The practitioner involved, when a report names one. Also nullable: a
  // medication error found in a shared drug cupboard may involve nobody in
  // particular, and a system fault is the most valuable kind to hear about.
  subjectUserId String? @map("subject_user_id") @db.Uuid

  reportedBy String   @map("reported_by") @db.Uuid
  occurredAt DateTime @map("occurred_at")
  reportedAt DateTime @default(now()) @map("reported_at")

  severity IncidentSeverity
  category IncidentCategory
  summary  String

  status IncidentStatus @default(REPORTED)

  // Filled when compliance closes it. A closure needs an outcome and a
  // reason, the same rule a dispute resolution and a fault finding follow.
  outcome     IncidentOutcome?
  closedBy    String?   @map("closed_by") @db.Uuid
  closedAt    DateTime? @map("closed_at")
  closureNotes String?  @map("closure_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  facility    Facility             @relation(fields: [facilityId], references: [id])
  assignment  Assignment?          @relation(fields: [assignmentId], references: [id])
  attachments IncidentAttachment[]

  @@index([facilityId, reportedAt])
  @@index([subjectUserId, reportedAt])
  @@index([status, severity])
  @@map("clinical_incidents")
  @@schema("clinical_incidents")
}

enum IncidentSeverity {
  // Nothing reached the patient. The most useful reports and the easiest to
  // lose, which is why it is first in the list rather than an afterthought.
  NEAR_MISS
  MINOR
  MODERATE
  SEVERE
  DEATH

  @@schema("clinical_incidents")
}

enum IncidentCategory {
  MEDICATION
  CLINICAL_PROCEDURE
  DOCUMENTATION
  INFECTION_CONTROL
  EQUIPMENT
  STAFFING
  CONDUCT
  OTHER

  @@schema("clinical_incidents")
}

enum IncidentStatus {
  REPORTED
  UNDER_REVIEW
  CLOSED

  @@schema("clinical_incidents")
}

enum IncidentOutcome {
  // The report was right and the cause was the system, not a person. The
  // commonest true answer, and the one a blame-first process never reaches.
  SYSTEM_ISSUE
  NO_ACTION
  ADVICE_GIVEN
  TRAINING_REQUIRED
  PRACTITIONER_SUSPENDED
  REFERRED_TO_REGULATOR

  @@schema("clinical_incidents")
}

// Photographs, drug charts, incident forms. Only the key, per the convention
// at the top of this schema. Append-only, like dispute evidence.
model IncidentAttachment {
  id         String  @id @default(uuid()) @db.Uuid
  incidentId String  @map("incident_id") @db.Uuid
  objectKey  String  @map("object_key")
  attachedBy String  @map("attached_by") @db.Uuid
  note       String?

  createdAt DateTime @default(now()) @map("created_at")

  incident ClinicalIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, objectKey])
  @@index([incidentId, createdAt])
  @@map("incident_attachments")
  @@schema("clinical_incidents")
}

// Every suspension and every reinstatement, kept whichever way it went.
//
// `identity.users.status` says what a user is now; this says how it got there
// and why. A suspension with no recorded reason is one nobody can lift with
// any confidence, and the reinstatement is as much a decision as the
// suspension was.
model AccountSuspension {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  reason      String
  suspendedBy String   @map("suspended_by") @db.Uuid
  suspendedAt DateTime @default(now()) @map("suspended_at")

  // The incident that caused it, when one did. A suspension can also come
  // from compliance directly, so this is nullable.
  incidentId String? @map("incident_id") @db.Uuid

  liftedBy     String?   @map("lifted_by") @db.Uuid
  liftedAt     DateTime? @map("lifted_at")
  liftedReason String?   @map("lifted_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, suspendedAt])
  @@index([liftedAt])
  @@map("account_suspensions")
  @@schema("clinical_incidents")
}

// -------------------------------------------------------------- suggestions

// Module 18, step 9.5. What people said did not work.
//
// The pilot's whole purpose is to find out what the specification got wrong,
// and that only works if there is somewhere for the finding to go that is not
// a WhatsApp message to the founder. Two sources feed it: somebody typing
// one, and a decline reason from step 6.5, which is already a practitioner
// saying why a shift did not suit them.
model Suggestion {
  id String @id @default(uuid()) @db.Uuid

  source SuggestionSource @default(USER)
  // Null for a derived one: an invitation decline has an author, but they
  // were answering an invitation rather than filing a suggestion, and
  // attributing it to them would be putting words in their mouth.
  raisedBy String? @map("raised_by") @db.Uuid

  // What it is about, so the log can be read by theme rather than by date.
  area SuggestionArea
  body String

  // Where a derived one came from, e.g. the invitation whose decline reason
  // this is. Free-form because the sources are in different schemas and a
  // foreign key to "one of three tables" is not a thing.
  sourceRef String? @map("source_ref")

  status SuggestionStatus @default(NEW)

  triagedBy String?   @map("triaged_by") @db.Uuid
  triagedAt DateTime? @map("triaged_at")
  // Why it was planned, done or declined. A declined suggestion with no
  // reason is how a pilot teaches people not to bother.
  response  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([area, createdAt])
  @@map("suggestions")
  @@schema("suggestions")
}

enum SuggestionSource {
  USER
  // A decline reason from step 6.5. The comment there says the suggestion
  // log is built from exactly this.
  DECLINE_REASON

  @@schema("suggestions")
}

enum SuggestionArea {
  ONBOARDING
  CREDENTIALS
  MATCHING
  SCHEDULING
  ATTENDANCE
  TIMESHEETS
  PAYMENTS
  SUPPORT
  OTHER

  @@schema("suggestions")
}

enum SuggestionStatus {
  NEW
  TRIAGED
  PLANNED
  DONE
  // Kept, with a reason. Nothing is deleted from a log whose value is that it
  // records what people actually asked for.
  DECLINED

  @@schema("suggestions")
}

// ------------------------------------------------------------------- rates

// Module 11. What a facility pays on top of the agreed hourly rate for
// unsociable hours. Multipliers are basis points — 15000 is 1.5x — because
// money is integer kobo (rule 3) and a float multiplier reintroduces the
// rounding argument one line later.
//
// Every multiplier defaults to par. The platform does not decide what a night
// is worth to a hospital; until a facility sets one, the figures are exactly
// what they were before this table existed.
model RateCard {
  id         String @id @default(uuid()) @db.Uuid
  facilityId String @map("facility_id") @db.Uuid
  name       String

  nightMultiplierBp    Int @default(10000) @map("night_multiplier_bp")
  holidayMultiplierBp  Int @default(10000) @map("holiday_multiplier_bp")
  overtimeMultiplierBp Int @default(10000) @map("overtime_multiplier_bp")
  onCallMultiplierBp   Int @default(10000) @map("on_call_multiplier_bp")

  status        RateCardStatus @default(DRAFT)
  effectiveFrom DateTime       @map("effective_from")
  // Null while current. A superseded card keeps its dates so an invoice
  // raised last month can still be read against the card that priced it.
  effectiveUntil DateTime?     @map("effective_until")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, status, effectiveFrom])
  @@map("rate_cards")
  @@schema("rates")
}

enum RateCardStatus {
  DRAFT
  ACTIVE
  // Replaced by a later card. Never deleted: an invoice has to remain
  // readable against the card that priced it.
  SUPERSEDED

  @@schema("rates")
}

// ----------------------------------------------------------------- billing

// Module 12. What a facility owes for work already approved.
model Invoice {
  id         String @id @default(uuid()) @db.Uuid
  facilityId String @map("facility_id") @db.Uuid
  number     String @unique

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  // Integer kobo throughout. `grossKobo` is what the lines come to;
  // `platformFeeKobo` is Medilink's share and is zero until step 3.1.
  grossKobo       Int @map("gross_kobo")
  platformFeeKobo Int @default(0) @map("platform_fee_kobo")
  currency        String @default("NGN")

  status   InvoiceStatus @default(DRAFT)
  issuedAt DateTime?     @map("issued_at")
  paidAt   DateTime?     @map("paid_at")

  // What was recorded when somebody marked it paid, so the payment can be checked
  // against a bank statement later (BIL-07). `paidAt` is when it was recorded;
  // `paidOn` is when the money arrived. The amount must equal `grossKobo` today,
  // because there is no model for part payments. Null on an invoice paid before
  // these were captured.
  paymentReference  String? @map("payment_reference")
  paymentAmountKobo Int?    @map("payment_amount_kobo")
  paidOn            DateTime? @map("paid_on") @db.Date
  payerName         String? @map("payer_name")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  facility Facility      @relation(fields: [facilityId], references: [id])
  lines    InvoiceLine[]

  // Statements and spend by period, for one facility; status is the last column
  // so it narrows within a period rather than before it.
  @@index([facilityId, periodStart, status])
  @@map("invoices")
  @@schema("billing")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  // Kept, never deleted, for the reason a credit note exists at all.
  VOID

  @@schema("billing")
}

// One approved shift on an invoice, with the bands it was priced from. The
// breakdown is stored rather than recomputed: a rate card can be superseded,
// and an invoice must still say what it said when it was issued.
model InvoiceLine {
  id           String @id @default(uuid()) @db.Uuid
  invoiceId    String @map("invoice_id") @db.Uuid
  /// One live line per shift: a partial unique index over `voided_at IS NULL`,
  /// in migrations/20261013160000_invoice_lines_voidable. Prisma cannot express
  /// it, so there is no `@unique` here.
  assignmentId String @map("assignment_id") @db.Uuid

  /// The rate card that priced it, so the figures can be explained later.
  rateCardId String? @map("rate_card_id") @db.Uuid

  practitionerId String @map("practitioner_id") @db.Uuid
  hourlyRateKobo Int    @map("hourly_rate_kobo")

  ordinaryMinutes Int @map("ordinary_minutes")
  nightMinutes    Int @map("night_minutes")
  holidayMinutes  Int @map("holiday_minutes")
  overtimeMinutes Int @map("overtime_minutes")
  onCallMinutes   Int @map("on_call_minutes")

  baseKobo    Int @map("base_kobo")
  premiumKobo Int @map("premium_kobo")
  amountKobo  Int @map("amount_kobo")

  createdAt DateTime  @default(now()) @map("created_at")
  /// Set when the invoice is voided. The line is kept; it no longer pins the shift.
  voidedAt  DateTime? @map("voided_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([assignmentId])
  @@map("invoice_lines")
  @@schema("billing")
}

// Double-entry. Every movement is two rows or more, and a transaction that
// does not sum to zero is refused before it is written — see
// `assertBalanced` in the domain. Append-only: a mistake is corrected by a
// reversing transaction, never by an update.
model LedgerEntry {
  id            String @id @default(uuid()) @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid

  account String
  /// Signed. Positive increases what the account holds.
  amountKobo Int    @map("amount_kobo")
  currency   String @default("NGN")

  /// The facility or practitioner this side belongs to; null for the
  /// platform's own accounts.
  subjectId String? @map("subject_id") @db.Uuid
  memo      String

  invoiceId String? @map("invoice_id") @db.Uuid
  payoutId  String? @map("payout_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([transactionId])
  @@index([account, subjectId])
  @@map("ledger_entries")
  @@schema("billing")
}

// What a practitioner is paid. Nothing here moves money on its own: a payout
// is prepared, a person releases it, and only then does the adapter run.
model Payout {
  id             String @id @default(uuid()) @db.Uuid
  practitionerId String @map("practitioner_id") @db.Uuid

  amountKobo Int    @map("amount_kobo")
  currency   String @default("NGN")

  status PayoutStatus @default(PREPARED)

  /// The gateway's own identifier, once it has one. Null while stubbed.
  providerReference String? @map("provider_reference")
  failureReason     String? @map("failure_reason")

  // Who prepared it, so release can refuse the same person (UXO-03). Null on a
  // payout prepared before this was recorded, which nothing then holds back.
  preparedBy String?   @map("prepared_by") @db.Uuid
  releasedBy String?   @map("released_by") @db.Uuid
  releasedAt DateTime? @map("released_at")
  settledAt  DateTime? @map("settled_at")
  /// The date the bank transfer was made, as finance recorded it, when a person
  /// paid it by hand (BIL-05). Null for a payout a gateway settled.
  paidOn DateTime? @map("paid_on") @db.Date

  /// The verified account this was prepared for (BIL-06). Releasing checks it is
  /// still the practitioner's, so an account changed in between is not paid to. Null
  /// on a payout prepared before accounts were recorded.
  accountId String? @map("account_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  practitioner User @relation(fields: [practitionerId], references: [id])

  @@index([practitionerId, status])
  @@map("payouts")
  @@schema("billing")
}

/// Where a practitioner is paid (BIL-06). A practitioner gives one, a finance
/// officer verifies it, and a payout is made only to a verified one. At most one is
/// PENDING and at most one VERIFIED per person, which the database holds with two
/// partial unique indexes Prisma cannot express (see the migration).
enum PayoutAccountStatus {
  PENDING
  VERIFIED
  REJECTED
  /// Superseded by a newer one, or withdrawn by the practitioner submitting another.
  REPLACED

  @@schema("billing")
}

model PayoutAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  bankName String @map("bank_name")
  /// The name the bank holds the account under, as the practitioner gave it.
  accountName String @map("account_name")
  accountLast4 String @map("account_last4")
  /// AES-256-GCM under PAYOUT_ACCOUNT_KEY (see infrastructure/account-vault.ts).
  /// Opened only to show finance where to transfer, and each time is audited.
  accountNumberSealed String @map("account_number_sealed")
  /// A keyed hash of the number, so one account given by two people is found
  /// without opening either.
  fingerprint String

  status PayoutAccountStatus @default(PENDING)

  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at")
  /// Why it was rejected, or why a mismatch was accepted.
  reviewNote String? @map("review_note")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([fingerprint])
  @@map("payout_accounts")
  @@schema("billing")
}

enum PayoutStatus {
  PREPARED
  RELEASED
  SETTLED
  FAILED
  /// Withdrawn by finance before anybody released it.
  CANCELLED

  @@schema("billing")
}

// ---------------------------------------------------------------- consent

// Module 17's other two thirds. The audit trail says what the platform did;
// these say what it was permitted to do, and to whom it must answer.
//
// Nigeria's Data Protection Act 2023 gives a data subject rights that only
// exist if there is a record to exercise them against: what they agreed to,
// when, and under which version of the terms.

// A version of a document somebody has to agree to. The specification is
// explicit that **the version identifier is stored, not the file name** — a
// file can be replaced in place and a version cannot.
model AgreementVersion {
  id        String        @id @default(uuid()) @db.Uuid
  kind      AgreementKind
  /// Human-readable and stable, e.g. "practitioner-engagement-v2".
  identifier String       @unique
  title      String
  /// The text itself, so what somebody agreed to is readable years later
  /// without depending on a file that may have moved.
  body       String
  effectiveFrom DateTime  @map("effective_from")
  /// Null while current. Never deleted: an acceptance must stay readable.
  retiredAt     DateTime? @map("retired_at")

  publishedBy String   @map("published_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  acceptances AgreementAcceptance[]

  @@index([kind, effectiveFrom])
  @@map("agreement_versions")
  @@schema("consent")
}

enum AgreementKind {
  PRACTITIONER_ENGAGEMENT
  FACILITY_TERMS
  PRIVACY_NOTICE

  @@schema("consent")
}

// Append-only. Somebody agreed to a specific version at a specific moment,
// and superseding the agreement does not un-agree the old one.
model AgreementAcceptance {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  versionId String @map("version_id") @db.Uuid

  acceptedAt DateTime @default(now()) @map("accepted_at")
  /// Evidence of the act, not tracking: what a dispute about "I never agreed
  /// to that" is actually settled with.
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  version AgreementVersion @relation(fields: [versionId], references: [id])

  @@unique([userId, versionId])
  @@index([userId, acceptedAt])
  @@map("agreement_acceptances")
  @@schema("consent")
}

// Consent to a specific processing purpose, separately from the terms.
//
// Kept apart from AgreementAcceptance on purpose: agreeing to engagement
// terms is a contract, and consent to share a credential with a hospital is a
// lawful basis that can be **withdrawn without ending the contract**. Rolling
// them together would make withdrawal impossible to express.
model ConsentRecord {
  id      String         @id @default(uuid()) @db.Uuid
  userId  String         @map("user_id") @db.Uuid
  purpose ConsentPurpose

  granted     Boolean
  /// Why it is lawful to process this at all. Consent is only one of the
  /// bases the Act allows, and recording which one applies is what makes a
  /// withdrawal answerable.
  lawfulBasis LawfulBasis @default(CONSENT) @map("lawful_basis")

  grantedAt   DateTime  @default(now()) @map("granted_at")
  withdrawnAt DateTime? @map("withdrawn_at")
  /// Required on withdrawal, so the record says what changed and why.
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, grantedAt])
  @@map("consent_records")
  @@schema("consent")
}

enum ConsentPurpose {
  /// Checking a NIN against NIMC.
  IDENTITY_VERIFICATION
  /// Showing a credential to a facility considering them for a shift.
  CREDENTIAL_SHARING
  /// Keeping a profile visible to facilities searching for cover.
  PROFILE_VISIBILITY
  /// Anything optional. Withdrawable with no effect on getting work.
  MARKETING

  @@schema("consent")
}

enum LawfulBasis {
  CONSENT
  /// Performing the engagement the practitioner signed.
  CONTRACT
  /// Verifying a licence, because a regulator requires it.
  LEGAL_OBLIGATION
  /// Patient safety.
  VITAL_INTERESTS

  @@schema("consent")
}

// A data subject exercising a right under the Act. Recorded rather than
// handled ad hoc, because "we did answer that" is a claim needing evidence.
model DataSubjectRequest {
  id      String                 @id @default(uuid()) @db.Uuid
  userId  String                 @map("user_id") @db.Uuid
  kind    DataSubjectRequestKind
  status  DataSubjectRequestStatus @default(RECEIVED)

  /// What the subject asked for, in their words.
  detail   String?
  /// What was done, in the officer's. Required to close one.
  outcome  String?

  receivedAt  DateTime  @default(now()) @map("received_at")
  /// The Act expects a response within a month; this is what makes a breach
  /// of that visible rather than discovered.
  dueBy       DateTime  @map("due_by")
  completedAt DateTime? @map("completed_at")
  handledBy   String?   @map("handled_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, dueBy])
  @@map("data_subject_requests")
  @@schema("consent")
}

enum DataSubjectRequestKind {
  /// "What do you hold about me?"
  ACCESS
  /// "This is wrong."
  RECTIFICATION
  /// "Delete me." See the module doc: an audit row and a ledger entry cannot
  /// be deleted, so this is satisfied by pseudonymisation.
  ERASURE
  /// "Give me my data in a portable form."
  PORTABILITY
  /// "Stop processing this."
  RESTRICTION

  @@schema("consent")
}

enum DataSubjectRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  /// Refused, with a reason. A refusal is a lawful outcome and has to be
  /// recorded as carefully as a grant.
  REFUSED

  @@schema("consent")
}
