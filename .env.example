# ---------------------------------------------------------------------------
# Medilink environment. Copy to .env and fill in. Never commit .env.
# Every variable here is validated by src/lib/env.ts at boot.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000

# PostgreSQL — the single source of truth for structured data
DATABASE_URL=postgresql://medilink:medilink@localhost:5432/medilink?schema=public

# Sessions
SESSION_SECRET=change-me-32-chars-minimum-value-here

# Object storage — Tigris in staging/production, MinIO locally.
# Tigris is S3-compatible, so the same client serves both.
STORAGE_ENDPOINT=http://localhost:9000
# The address a browser can reach. Only differs from the above under Docker.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=medilink-documents
STORAGE_ACCESS_KEY_ID=medilink
STORAGE_SECRET_ACCESS_KEY=medilink-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Notifications (sandbox values only outside production)
# How a person reaches Medilink, shown on the landing page and /contact. Leave
# unset until a line is staffed: nothing is shown for an unset one, and a number
# that is not a Nigerian mobile is ignored.
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
SUPPORT_HOURS=

# console (local only) | termii | africastalking. A real provider needs its credentials, and
# staging and production refuse to start without them:
#   termii          SMS_API_KEY and SMS_SENDER_ID (a sender ID registered with Termii)
#   africastalking  SMS_API_KEY and SMS_USERNAME ('sandbox' for its sandbox); SMS_SENDER_ID optional
# The adapters are written to each provider's documented API and have not been run against a
# live account: send a real code to a real phone before relying on either.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
SMS_USERNAME=
# Console adapter only: also append each message to this file (the browser
# journeys read one-time codes from it). docker-compose.yml sets it.
SMS_CONSOLE_OUTBOX=
SMTP_URL=smtp://localhost:1025

# Payouts: the person who prepared a payout cannot release it, so two people stand
# between a balance and the bank. Leave this unset. Set it to `off` only for a pilot
# with a single person who can manage payouts, as a decision and not as a default;
# any other value, including a typo, leaves the rule on.
# PAYOUT_SECOND_APPROVER=off

# Payouts: a practitioner is paid only from money a facility has actually paid, not
# from what the facility has been billed, so the platform never pays out cash it has
# not received. Leave this unset. Set it to `off` only if the platform pays from its
# own funds and recovers it from facilities later, as a commercial decision and not
# as a default; any other value, including a typo, leaves the rule on.
# PAYOUT_REQUIRES_COLLECTION=off

# Payouts: a practitioner is paid only into a bank account a finance officer has
# verified, once it has been theirs for PAYOUT_ACCOUNT_COOLING_HOURS (default 24, counted
# from when they gave it, so a stranger adding an account to a stolen session has a day
# in which the person it belongs to is texted and can say so). Leave both unset. `off` for
# the account rule is for a pilot paying from details taken elsewhere, as a decision;
# anything but exactly `off` leaves it on. A bad number of hours is read as 24, never 0.
# PAYOUT_REQUIRES_ACCOUNT=off
# PAYOUT_ACCOUNT_COOLING_HOURS=24

# The key that seals the account numbers practitioners are paid into. At least 32
# characters, generated once and kept outside the database and its backups, for example
# `openssl rand -base64 48`. Required in staging and production, where the process refuses
# to start without it; a local process falls back to a fixed key that protects nothing.
# Changing it makes every stored number unreadable, and practitioners are asked for theirs
# again.
PAYOUT_ACCOUNT_KEY=

# Payments (Stage 8 — sandbox credentials only)
#   console  local only: pretends a payout went through, and says so in its reference.
#   manual   no gateway: releasing a payout hands it to finance, who make the bank
#            transfer themselves and record its reference and date, which completes it.
#            Allowed in staging and production; this is how a pilot pays people.
#   none     refuses every release until a real provider exists.
PAYMENT_PROVIDER=console
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Identity and professional-registration verification.
# Both default to `none`: they need paid provider subscriptions, and with them
# off a compliance officer records the evidence by hand. Set to sandbox or live
# only once a subscription and an API key exist.
NIN_VERIFICATION_PROVIDER=none
NIN_VERIFICATION_API_KEY=
MDCN_VERIFICATION_PROVIDER=none
MDCN_VERIFICATION_API_KEY=

# Observability
LOG_LEVEL=info
